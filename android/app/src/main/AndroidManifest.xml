<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Aucun identifiant publicitaire.
         La console Play a reçu la réponse « Non » à la question « votre appli
         utilise-t-elle un identifiant publicitaire ? ». Ces permissions ne sont
         écrites nulle part ici, mais une bibliothèque peut les ajouter d'office
         au manifeste fusionné : firebase-analytics le faisait, avant d'être
         retiré. tools:node="remove" les efface quelle qu'en soit l'origine, pour
         que la déclaration reste vraie même si un greffon les ramène. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <!-- Aucun accès étendu aux photos et vidéos.
         La galerie passe par le sélecteur de photos du système
         (image_picker, useAndroidPhotoPicker activé dans main.dart) : il ne
         donne à l'application que les images que la personne choisit, et ne
         demande aucune autorisation.

         READ_MEDIA_IMAGES et READ_EXTERNAL_STORAGE étaient déclarées ici par
         habitude. Play a bloqué la version 45 pour la première : depuis Android
         13, ces autorisations étendues ne sont admises que si un sélecteur
         système ne peut pas faire l'affaire — ce n'est pas le cas.
         tools:node="remove" les efface aussi si un greffon les ramène. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- Caméra : prise de photo du catalogue par le personnel. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <application
        android:label="AutoParc"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher : ouvrir des liens https (WhatsApp, etc.) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- url_launcher : liens tel: -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
