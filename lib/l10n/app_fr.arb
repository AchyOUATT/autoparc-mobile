  "catalogDealFilterCount": "Bonne affaire ({count})",
  "@catalogDealFilterCount": {
    "description": "La même puce quand le serveur annonce des promotions. Le compte est entre parenthèses et non suffixé : la puce pulse trois fois pour se faire remarquer, et un nombre collé au libellé grandirait la cible pendant la pulsation.",
