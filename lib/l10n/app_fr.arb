  "catalogSectionDescription": "Description",
  "@catalogSectionDescription": {
    "description": "Titre du bloc de description libre d'une pièce ou d'un accessoire. Le TEXTE vient du serveur et n'est pas traduit. Identique en anglais."
  },
  "catalogSectionInformation": "Informations",
  "@catalogSectionInformation": {
    "description": "Titre de la carte d'informations produit d'une pièce ou d'un accessoire : type, état, catégorie, fabricant. PLURIEL EN FRANÇAIS, SINGULIER EN ANGLAIS — « Information » est indénombrable, et « Informations » s'y lirait comme une faute."
