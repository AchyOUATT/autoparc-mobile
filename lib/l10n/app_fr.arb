  "catalogFieldSalePrice": "Prix de vente",
  "@catalogFieldSalePrice": {
    "description": "Libellé de la ligne de prix dans la carte de prix d'une pièce. Le MONTANT, à droite, reste entier : il passe à la ligne plutôt que d'être tronqué, un montant abrégé valant moins que pas de montant. La ligne débordait avant que ses deux textes soient contraints — un prix à sept chiffres sur un petit écran suffisait."
  },
  "catalogFieldType": "Type",
  "@catalogFieldType": {
    "description": "Libellé de la ligne de nature d'une pièce. Identique en anglais."
  },
  "catalogFieldState": "État",
  "@catalogFieldState": {
    "description": "Libellé de la ligne d'état d'une pièce : neuf, reconditionné, usagé. Le français écrit « État » ici et « Condition » sur la fiche d'un VÉHICULE (catalogFieldCondition), pour la même notion ; l'anglais rend les deux par « Condition », et la divergence française disparaît donc à la traduction. Les deux lignes ne s'affichent JAMAIS sur le même écran — l'une est sur la fiche d'une pièce, l'autre sur celle d'un véhicule —, donc le même mot anglais n'y crée aucune ambiguïté. Clés distinctes quand même : les deux référentiels sont indépendants côté serveur, et une pièce « reconditionnée » n'a pas d'équivalent chez les véhicules."
  },
  "catalogFieldCategory": "Catégorie",
  "@catalogFieldCategory": {
    "description": "Libellé de la ligne de catégorie d'une pièce ou d'un accessoire. La VALEUR vient du référentiel du serveur et reste en français jusqu'à la vague serveur."
  },
  "catalogFieldSku": "SKU",
  "@catalogFieldSku": {
    "description": "Libellé de la ligne de référence interne d'un accessoire. Sigle identique dans les deux langues."
  },
  "catalogFieldManufacturer": "Fabricant",
  "@catalogFieldManufacturer": {
    "description": "Libellé de la ligne de fabricant d'une pièce ou d'un accessoire. La valeur vient du serveur.\n\n« Brand » ET NON « Manufacturer », ET C'EST UNE MESURE QUI L'A DÉCIDÉ. La colonne des libellés de la fiche d'une pièce est un `SizedBox` de 100 points de LARGE FIXE, qui ne suit pas l'échelle de texte ; « Manufacturer » est un seul mot insécable de 106,0 points à l'échelle 1,3 et de 121,8 à 1,5, donc il débordait de sa colonne et se peignait par-dessus la valeur — sans ellipse, parce qu'un mot plus large que sa ligne n'est pas une troncature que `didExceedMaxLines` voit. Relevé par le banc « Les écrans de la vague 2 », sur la seule colonne ANGLAISE : « Fabricant » tient.\n\n« Brand » est aussi le mot des catalogues de pièces, et il ne se confond pas avec catalogFieldBrand (« Marque », rendu « Make »), qui est la marque d'un VÉHICULE et vit sur un autre écran."
  },

  "catalogPartTypeOemLong": "OEM — Constructeur d'origine",
  "@catalogPartTypeOemLong": {
    "description": "La nature d'une pièce, DÉVELOPPÉE, telle que la fiche l'affiche. La liste, elle, n'a de place que pour le sigle : catalogPartTypeOem. Deux jeux de clés pour la même valeur `oem`, et c'était déjà deux chaînes différentes en français — une carte de catalogue n'a pas la largeur d'une ligne de fiche. Le tiret est un CADRATIN (U+2014), et il fait partie de la valeur."
  },
  "catalogPartTypeOesLong": "OES — Équipementier agréé",
  "@catalogPartTypeOesLong": {
    "description": "La nature d'une pièce, développée. Voir catalogPartTypeOemLong."
  },
  "catalogPartTypeAftermarketLong": "Aftermarket — Marché libre",
  "@catalogPartTypeAftermarketLong": {
    "description": "La nature d'une pièce, développée. Voir catalogPartTypeOemLong."
  },
  "catalogPartTypeSalvageLong": "Récupération / Occasion",
  "@catalogPartTypeSalvageLong": {
    "description": "La nature d'une pièce de récupération, développée. La seule des quatre sans sigle : elle n'a donc pas de cadratin, et sa barre oblique sépare deux synonymes du marché plutôt qu'un sigle de sa définition."
  },
  "catalogPartConditionNew": "Neuf",
  "@catalogPartConditionNew": {
    "description": "Valeur de la ligne « État » d'une pièce. Même mot que catalogConditionNew, qui qualifie un VÉHICULE ; deux clés, parce que les deux référentiels sont indépendants côté serveur et qu'une pièce « reconditionnée » n'a pas d'équivalent chez les véhicules."
  },
  "catalogPartConditionRefurbished": "Reconditionné",
  "@catalogPartConditionRefurbished": {
    "description": "Valeur de la ligne « État » d'une pièce : remise en état par un atelier, avec garantie. Distinct de catalogPartConditionUsed, qui est vendu tel quel."
  },
  "catalogPartConditionUsed": "Usagé",
  "@catalogPartConditionUsed": {
    "description": "Valeur de la ligne « État » d'une pièce, vendue en l'état. « Usagé » et non « Occasion », qui est le mot de la PROVENANCE (catalogPartTypeSalvage) : une pièce de récupération peut être reconditionnée, et une pièce neuve d'équipementier ne peut pas être usagée. Les deux colonnes sont indépendantes, et l'anglais garde la distinction avec « Used » contre « Salvage »."
  },

  "catalogAddToCart": "Ajouter au panier",
  "@catalogAddToCart": {
    "description": "Bouton de bas de fiche d'une pièce ou d'un accessoire. CONTRE-EXEMPLE UTILE : l'anglais est ici plus COURT — « Add to cart », 11 signes contre 17 —, alors que catalogCustomsCleared fait l'inverse. C'est pourquoi la longueur est mesurée cas par cas et non supposée."
